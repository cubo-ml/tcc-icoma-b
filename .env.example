# =========================================================
# SkillBloom - variaveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# O .env NAO vai para o Git (ja esta no .gitignore).
# Sem nenhuma dessas chaves o site sobe normalmente:
# apenas os botoes de login social avisam que estao
# indisponiveis.
# =========================================================

# Chave que assina o cookie de sessao do Flask.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
# EM PRODUCAO E OBRIGATORIA: sem ela cada worker do servidor
# inventa a sua, o cookie assinado por um e' recusado pelo outro e
# o login falha com ?erro=oauth_estado de vez em quando.
FLASK_SECRET_KEY=

# =========================================================
# COOKIE DE SESSAO
# Vazio = desligado, que e' o certo no http://localhost (com
# "1" o navegador so mandaria o cookie por https e ninguem
# conseguiria logar na propria maquina).
# Em producao, com https, deixe SESSION_COOKIE_SECURE=1.
# No Render nao precisa: a variavel RENDER ja liga sozinha.
# =========================================================
SESSION_COOKIE_SECURE=

# =========================================================
# HOSPEDAGEM
# PORT: a porta que o servidor escuta (o Render usa 10000).
# Atras de proxy com https o app ja aplica o ProxyFix, entao o
# redirect_uri do Google sai com https:// e nao da
# redirect_uri_mismatch.
# =========================================================
PORT=

# =========================================================
# GOOGLE
# console.cloud.google.com > APIs e servicos > Credenciais
# > Criar credenciais > ID do cliente OAuth > Aplicativo da Web.
# URI de redirecionamento autorizado (use a porta em que voce
# roda o Flask - 5000 no "flask run", 10000 no "python main.py"):
#   http://localhost:5000/auth/google/callback
# =========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================================================
# LINKEDIN
# developer.linkedin.com/apps > seu app > aba Auth.
# Produto necessario: "Sign In with LinkedIn using OpenID Connect".
# URL de redirecionamento autorizada (mesma porta do Flask):
#   http://localhost:5000/auth/linkedin/callback
# =========================================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
